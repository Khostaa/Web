---
import { getImage } from 'astro:assets';
import { giftMarkets } from '../lib/gifts.js';
const { gifts } = Astro.props;
const sources = import.meta.glob('../assets/gifts/*.{png,jpg,jpeg,webp}', { eager: true, import: 'default' });
const cards = await Promise.all(gifts.map(async gift => {
  const source = Object.entries(sources).find(([file]) => file.split('/').pop().replace(/\.[^.]+$/, '') === gift.image)?.[1];
  const variants = source ? await Promise.all([360, 720].map(width => getImage({ src: source, width, format: 'webp', quality: 80 }))) : [];
  return { ...gift, source, variants };
}));
---
<div class="gift-toolbar reveal">
  <label for="gift-country">Shopping from <select id="gift-country" aria-describedby="gift-store-note">
    <option value="GLOBAL">Choose country / region</option>
    {Object.entries(giftMarkets).filter(([code]) => code !== 'GLOBAL').sort((a,b) => a[1][0].localeCompare(b[1][0])).map(([code,market]) => <option value={code}>{market[0]}</option>)}
  </select></label>
  <div class="gallery-pager gift-pager" id="gift-pager" hidden><button id="gift-prev" aria-label="Previous gifts">←</button><span id="gift-page" aria-live="polite"></span><button id="gift-next" aria-label="Next gifts">→</button></div>
</div>
<div class="gifts-content gift-list" id="gifts">
  {cards.map((gift,index) => <article class="gift-item" data-gift-index={index}>
    <a class="gift-card-link" draggable="false" href={gift.url} target="_blank" rel="noopener noreferrer" aria-label={'View ' + gift.title + (gift.variant ? ', ' + gift.variant : '') + ' in a store (opens in new tab)'}>
      <div class:list={['gift-product', 'gift-product-' + gift.image]}>

        {gift.source && <img src={gift.variants[0].src} srcset={gift.variants.map((image,i) => image.src + ' ' + [360,720][i] + 'w').join(', ')} sizes="(max-width: 700px) 30vw, 30vw" width={gift.source.width} height={gift.source.height} alt={gift.title + (gift.variant ? ', ' + gift.variant : '')} loading="lazy" decoding="async" />}

      </div>
      <div class="gift-details"><span class="eyebrow">{gift.category || 'A LITTLE SOMETHING'}</span><h3>{gift.title}</h3>{gift.variant && <span class="gift-variant">{gift.variant}</span>}<p>{gift.note}</p><span class="gift-store">View brand website ↗</span></div>
    </a>
  </article>)}
</div>
<div class="gift-bottom reveal"><p id="gift-store-note" role="status">Choose a country for local store results. Other regions: choose your location on the brand website.</p><a class="text-link" href="#about">No pressure though, A kind word goes a long way, too <span>↗</span></a></div>
<noscript><p>Product links open brand websites. Choose your region there to shop locally.</p></noscript>
