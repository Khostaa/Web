---
const { platform = 'all' } = Astro.props;
---
<svg class="platform-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
  {platform === 'all' && <path d="M3 3h7v7H3zm11 0h7v7h-7zM3 14h7v7H3zm11 0h7v7h-7z" />}
  {platform === 'youtube' && <><rect x="2" y="5" width="20" height="14" rx="4"/><path d="m10 9 6 3-6 3z" fill="var(--bg)"/></>}
  {platform === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.5" cy="6.5" r="1.2"/></>}
  {platform === 'tiktok' && <path d="M14 2h3c.3 2.5 1.7 4 4 4.5v3a9 9 0 0 1-4-1.4V16a6 6 0 1 1-6-6v3a3 3 0 1 0 3 3z"/>}
</svg>
