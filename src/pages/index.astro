---
import themeCode from '../scripts/theme.js?raw';
import caslonItalicUrl from '../assets/fonts/LibreCaslonCondensed-Italic.woff2?url';
import { getImage } from 'astro:assets';
import '../styles/global.css';
import '../styles/glass.css';
import WorkGallery from '../components/WorkGallery.astro';
import GiftGallery from '../components/GiftGallery.astro';
import PlatformIcon from '../components/PlatformIcon.astro';
import SocialLinks from '../components/SocialLinks.astro';
import portfolio from '../data/portfolio.json';
import reel from '../assets/reel.jpg';
import showreel from '../assets/showreel.png';
import story from '../assets/story.jpg';
import social from '../assets/social.jpg';
import motion from '../assets/motion.jpg';
import portrait from '../assets/sunil-cutout.png';
import { safeUrl } from '../lib/media.js';
const images = {};
for (const [name, source] of Object.entries({ reel, story, social, motion })) {
  const variants = await Promise.all([480, 960].map(width => getImage({ src: source, width, format: 'webp', quality: 76 })));
  images['assets/' + name + '.jpg'] = { src: variants[1].src, small: variants[0].src, srcset: variants.map((image, index) => image.src + ' ' + [480, 960][index] + 'w').join(', '), width: source.width, height: source.height };
}
const showreelVariants = await Promise.all([480, 960].map(width => getImage({ src: showreel, width, format: 'webp', quality: 82 })));
images['assets/showreel.png'] = { src: showreelVariants[1].src, small: showreelVariants[0].src, srcset: showreelVariants.map((image, index) => image.src + ' ' + [480, 960][index] + 'w').join(', '), width: showreel.width, height: showreel.height };
const workSources = import.meta.glob('../assets/work/*.{jpg,jpeg,png,webp}', { eager: true, import: 'default' });
await Promise.all(Object.entries(workSources).map(async ([path,source]) => {
  const widths = source.width <= 480 ? [240,480] : [360,720];
  const variants = await Promise.all(widths.map(width => getImage({ src: source, width, format: 'webp', quality: 80 })));
  images['assets/work/' + path.split('/').pop()] = { src: variants[1].src, small: variants[0].src, srcset: variants.map((image,index) => image.src + ' ' + widths[index] + 'w').join(', '), width: source.width, height: source.height };
}));
const portraitImages = await Promise.all([360, 640].map(width => getImage({ src: portrait, width, format: 'webp', quality: 82 })));
const validWork = portfolio.videos.filter(video => safeUrl(video.url) && video.thumbnail);
const homePosters = ['youtube','instagram','tiktok'].map(platform => {
  const work = validWork.find(video => video.platform === platform && (platform !== 'youtube' || video.aspectRatio === '16:9'));
  return { image: work?.thumbnail || ({ youtube: portfolio.showreelThumbnail || 'assets/reel.jpg', instagram: 'assets/social.jpg', tiktok: 'assets/motion.jpg' }[platform]), platform };
});
const gifts = portfolio.gifts.filter(gift => safeUrl(gift.url));
---
<!doctype html>
<html lang="en" class="slideshow">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#1d1d35"><meta name="generator" content={Astro.generator}>
  <script is:inline set:html={themeCode}></script>
  <script is:inline>document.documentElement.classList.add('js');</script>
  <title>Sunil Paudel - Visuals &amp; Editing</title>
  <meta name="description" content="Choose your next frame. Films, small gestures, and the person behind the cut. Sunil Paudel, a.k.a Khosta.">
  <link rel="icon" href="/assets/logo.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500;550;600;650;700&display=swap" rel="stylesheet">
  <link rel="preload" href={caslonItalicUrl} as="font" type="font/woff2" crossorigin="anonymous">
  <script is:inline define:vars={{ portfolio }}>window.PORTFOLIO = portfolio;</script>
  <script src="../scripts/app.js"></script>
</head>
<body>
  <a class="skip" href="#work">Skip to work</a>
  <header class="header glass">
    <a class="wordmark" href="#home" aria-label="Khosta home"><span class="brand-logo" aria-hidden="true"></span>khosta</a>
    <button class="theme-toggle" id="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Light mode" title="Switch to light mode"><span class="theme-thumb" aria-hidden="true"></span><svg class="theme-moon" aria-hidden="true" viewBox="0 0 24 24"><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z"/></svg><svg class="theme-sun" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.5"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg></button>
    <nav aria-label="Main navigation"><a href="#work">Work</a><a href="#wishlist">Gifts</a><a class="hire-link" href="#about">Hire me <span aria-hidden="true">↗</span></a></nav>
  </header>
  <main class="stage" id="stage">
    <section class="screen home-screen is-active" id="home" aria-labelledby="home-title" data-preview="work">
      <div class="home-copy">
        <div class="eyebrow reveal"><span class="status-dot"></span> SUNIL PAUDEL / A.K.A KHOSTA</div>
        <h1 class="intro-title reveal" id="home-title" tabindex="-1">Hi! I’m <em>Sunil Paudel,</em></h1><p class="intro-description reveal">a freelance video editor and a visual storyteller based in Nepal.<br>I work with creators, brands, and teams to turn ideas and raw footage into videos worth watching.</p><button id="home-showreel" class="home-showreel glass reveal" aria-label="Watch showreel"><img src={images[portfolio.showreelThumbnail]?.small} width="160" height="90" alt="Showreel: restart."/><span><span class="showreel-play" aria-hidden="true">▶</span> Watch showreel <span aria-hidden="true">↗</span></span></button><h2 class="intent-heading reveal">What are you <em>looking for?</em></h2>
        <nav class="choices" aria-label="What are you looking for?">
          <a class="choice is-selected reveal" href="#work" data-preview-choice="work"><span class="choice-number">01</span><span class="choice-thumbnail"><img src={images[homePosters[0].image]?.small || homePosters[0].image} width="48" height="48" alt=""></span><span class="choice-text">See my work</span><span class="choice-arrow" aria-hidden="true">↗</span></a>
          <a class="choice reveal" href="#about" data-preview-choice="about"><span class="choice-number">02</span><span class="choice-thumbnail about-thumbnail brand-logo logo-static" aria-hidden="true"></span><span class="choice-text">Let's talk</span><span class="choice-arrow" aria-hidden="true">↗</span></a>
          <a class="choice reveal" href="#wishlist" data-preview-choice="wishlist"><span class="choice-number">03</span><span class="choice-thumbnail gift-thumbnail" aria-hidden="true">✳</span><span class="choice-text">Things I'd love</span><span class="choice-arrow" aria-hidden="true">↗</span></a>
        </nav>
        <p class="home-caption location reveal"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg> Nepal <span>Available worldwide</span></p>
      </div>
      <div class="home-art" aria-hidden="true">
        <div class="intent-preview preview-work">
          {homePosters.map((poster,index) => <div class:list={['art-photo', ['art-large','art-small','art-wide'][index]]}><img src={images[poster.image]?.src || poster.image} srcset={images[poster.image]?.srcset} sizes="400px" width={images[poster.image]?.width} height={images[poster.image]?.height} alt="" loading={index ? 'lazy' : 'eager'} /><span class="preview-platform"><PlatformIcon platform={poster.platform} /></span></div>)}
          <span class="art-marker">01 / SELECTED MOMENTS</span>
        </div>
        <div class="intent-preview preview-wishlist"><div class="gift-note"><span class="eyebrow">A LITTLE SOMETHING</span><span class="gift-drawing">✳</span><p>Got something<br><em>in mind?</em></p><span class="note-signature">Explore my wishlist</span></div><span class="art-marker">03 / GOOD ENERGY ONLY</span></div>
        <div class="intent-preview preview-about"><span class="about-orbit brand-logo" aria-hidden="true"></span><p>Behind<br><em>the cut.</em></p><span class="art-marker">02 / THE PERSON, THE PROCESS</span></div>
      </div>
    </section>

    <section class="screen work-screen" id="work" aria-labelledby="work-title">
      <div class="screen-heading"><div><div class="eyebrow reveal">01 / SELECTED WORK</div><h2 id="work-title" class="reveal" tabindex="-1">Less noise. <em>More story.</em></h2></div><p class="section-note reveal">From quick social videos to longer edits, I enjoy finding the right rhythm, shaping the story, and getting the little details right.</p></div>
      <dl class="work-stats reveal" aria-label="Experience and impact">{portfolio.stats.map(stat => <div><dt>{stat.label}</dt><dd>{stat.value}</dd></div>)}</dl>
      <div class="service-list reveal" aria-label="Video services">{portfolio.services.map(service => <span>{service}</span>)}</div>
      <div class="work-body">
        <div class="work-toolbar reveal"><div class="filters" role="group" aria-label="Filter videos">{[['short','Short form'],['long','Long form']].map(([platform,label]) => <button class:list={{active: platform === 'short'}} data-filter={platform} aria-pressed={platform === 'short'} aria-label={label}><svg class="platform-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">{platform === 'short' ? <><rect x="6" y="2" width="12" height="20" rx="3"/><path d="m10 8 5 4-5 4z"/></> : <><rect x="2" y="5" width="20" height="14" rx="3"/><path d="m10 9 5 3-5 3z"/></>}</svg><span>{label}</span></button>)}</div><div class="work-subfilters" role="group" aria-label="Short-form categories">{[['all','All short form'],['sports','Sports promos'],['education','Educational'],['social','Social & creative']].map(([value,label]) => <button data-category={value} class:list={{active:value==='all'}} aria-pressed={value==='all'}>{label}</button>)}</div><span class="work-count" id="work-page" aria-live="polite">{portfolio.videos.filter(video => video.format === 'short').length} edits</span></div>
        <div class="work-viewport"><WorkGallery portfolio={portfolio} images={images} /><span class="grid-soft-edge edge-top" aria-hidden="true"></span><span class="grid-soft-edge edge-bottom" aria-hidden="true"></span></div>
      </div>
      <p class="work-footnote reveal" id="work-footnote">Scroll the tiles to explore faster. Hover to pause. Click to play.</p>
    </section>

    <section class:list={['screen gifts-screen', { 'has-gifts': gifts.length }]} id="wishlist" aria-labelledby="wishlist-title">
      <div class="screen-heading"><div><div class="eyebrow reveal">02 / A LITTLE SOMETHING <span aria-hidden="true">✳</span></div><h2 id="wishlist-title" class="reveal" tabindex="-1">Got something <em>in mind?</em></h2></div><div class="gift-introduction section-note reveal"><p>If you're wondering what I'd actually use, here's a little list of things on my wishlist.</p></div></div>
      {gifts.length ? <GiftGallery gifts={gifts} /> : <div class="wishlist-empty reveal" id="gifts"><h3>Nothing on the list. Just good energy.</h3><p>A few wishes might find their way here soon.</p><a class="text-link" href="#about">A kind word works, too ↗</a></div>}
    </section>

    <section class="screen about-screen" id="about" aria-labelledby="about-title">
      <figure class="editor-portrait reveal"><span class="portrait-glow" aria-hidden="true"></span><img src={portraitImages[1].src} srcset={portraitImages[0].src + ' 360w, ' + portraitImages[1].src + ' 640w'} sizes="(max-width: 700px) 220px, 440px" width={portrait.width} height={portrait.height} alt="Sunil Paudel, also known as Khosta, video editor" loading="lazy" decoding="async"/><span class="portrait-label label-video glass">↗ Video editor</span><span class="portrait-label label-motion glass">✳ Motion designer</span><span class="portrait-label label-available glass"><span class="status-dot"></span> Available for projects</span></figure>
      <div class="about-copy"><div class="eyebrow reveal">03 / LET’S MAKE SOMETHING</div><h2 class="reveal" id="about-title" tabindex="-1">Hi, I’m Sunil.<br>Call me <em>Khosta.</em></h2><div class="about-intro reveal"><p>I'm a video editor who enjoys figuring out what makes a story work. I'm always learning, trying new things, and looking for the next interesting project.</p><p>Whether you're a brand with a story to tell, a team looking for an editor, or a creator with an idea, I'm always up for a good conversation.</p></div><p class="location about-location reveal"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg> Nepal <span>Available worldwide.</span></p><div class="tools-list reveal" aria-label="Creative tools">{portfolio.tools.map(tool => <span class="glass">{tool}</span>)}</div><div class="contact-block reveal"><h3 class="contact-question">Have a story in mind?</h3><a class="contact-email" id="email-link" href={'mailto:' + portfolio.email}>{portfolio.email}<span>↗</span></a><div class="contact-details"><a id="phone-link" href={'tel:' + portfolio.phone}>{portfolio.phoneDisplay}</a><button id="copy-email">Copy email ⧉</button><span id="copy-status" role="status" aria-live="polite"></span></div></div><div class="social-window reveal"><SocialLinks links={portfolio.socials || []} /><div class="social-pager"><button id="social-prev" aria-label="Previous social profiles">←</button><span id="social-page"></span><button id="social-next" aria-label="Next social profiles">→</button></div></div></div>
    </section>
  </main>
  <footer class="screen-footer"><span class="footer-note"><span class="status-dot"></span> Freelance Video Editor / Filmmaker</span><span class="drag-hint">Drag / swipe ↔</span><nav class="screen-dots" aria-label="Choose a screen"><a href="#home" aria-label="Start" aria-current="page"></a><a href="#work" aria-label="Work"></a><a href="#wishlist" aria-label="Gifts"></a><a href="#about" aria-label="Hire me"></a></nav><div class="screen-controls"><span id="screen-position" aria-live="polite">01 / 04</span><button id="screen-prev" aria-label="Previous screen">←</button><button id="screen-next" aria-label="Next screen">→</button></div></footer>
  <dialog class="video-dialog" id="video-dialog" aria-labelledby="video-title"><div class="dialog-head"><div><span class="eyebrow" id="video-platform"></span><h3 id="video-title"></h3></div><button class="close-dialog" aria-label="Close video">✕</button></div><div id="video-player"></div><div class="dialog-foot"><span id="video-description"></span><a id="original-link" target="_blank" rel="noopener noreferrer">Watch on original platform ↗</a></div></dialog>
  <noscript><p class="no-script-note">JavaScript enables the animated slideshow. All content is available below without it.</p></noscript>
</body>
</html>
