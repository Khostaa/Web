---
import themeCode from '../scripts/theme.js?raw';
import caslonItalicUrl from '../assets/fonts/LibreCaslonCondensed-Italic.woff2?url';
import { getImage } from 'astro:assets';
import '../styles/global.css';
import WorkGallery from '../components/WorkGallery.astro';
import SocialLinks from '../components/SocialLinks.astro';
import portfolio from '../data/portfolio.json';
import reel from '../assets/reel.jpg';
import story from '../assets/story.jpg';
import social from '../assets/social.jpg';
import motion from '../assets/motion.jpg';
import portrait from '../assets/sunil-portrait.png';
import { parseVideo } from '../lib/media.js';
const hasShowreel = Boolean(parseVideo(portfolio.showreelUrl));
const portraitVariants = await Promise.all([360, 640].map(width => getImage({ src: portrait, width, format: 'webp', quality: 82 })));
const heroVariants = await Promise.all([640, 960, 1280, 1800].map(width => getImage({ src: reel, width, format: 'webp', quality: 78 })));
const heroSrcset = heroVariants.map((image, index) => image.src + ' ' + [640, 960, 1280, 1800][index] + 'w').join(', ');
const optimizedImages = {};
for (const [name, source] of Object.entries({ reel, story, social, motion })) {
  const variants = await Promise.all([400, 800].map(width => getImage({ src: source, width, format: 'webp', quality: 78 })));
  optimizedImages['assets/' + name + '.jpg'] = { src: variants[1].src, srcset: variants.map((image, index) => image.src + ' ' + [400, 800][index] + 'w').join(', '), width: source.width, height: source.height };
}
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#1d1d35">
  <meta name="generator" content={Astro.generator}>
  <script is:inline set:html={themeCode}></script>
  <title>Khosta — Sunil Paudel · Video Editor</title>
  <meta name="description" content="Sunil Paudel, a.k.a Khosta. Video editing with a feeling. Explore the work, start a conversation, or find a little something on the wishlist.">
  <link rel="icon" href="/assets/logo.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500;550;600;650;700&display=swap" rel="stylesheet">
  <link rel="preload" href={caslonItalicUrl} as="font" type="font/woff2" crossorigin="anonymous">

  <script is:inline define:vars={{ portfolio, optimizedImages }}>window.PORTFOLIO = portfolio; window.PORTFOLIO_IMAGES = optimizedImages;</script>
  <script src="../scripts/app.js"></script>
</head>
<body>
  <a class="skip" href="#work">Skip to work</a>
  <header class="header wrap">
    <a class="wordmark" href="#" aria-label="Khosta home"><span class="brand-logo" aria-hidden="true"></span><span>khosta</span></a>
    <nav aria-label="Main navigation"><a href="#work">Work</a><a href="#about">About</a><a href="#wishlist">Wishlist <span class="nav-gift">↗</span></a></nav>
    <div class="header-actions">
      <button class="theme-toggle" id="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Light mode" title="Switch to light mode">
        <span class="theme-thumb" aria-hidden="true"></span>
        <svg class="theme-moon" aria-hidden="true" viewBox="0 0 24 24"><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z"/></svg>
        <svg class="theme-sun" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.5"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
      </button>
      <a class="nav-contact" href="#contact">Let’s talk <span>↗</span></a>
    </div>
  </header>
  <main>
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-stage">
      <figure class="paper-portrait">
        <div class="paper-sheet">
          <div class="portrait-window"><img src={portraitVariants[1].src} srcset={`${portraitVariants[0].src} 360w, ${portraitVariants[1].src} 640w`} sizes="(max-width: 700px) 180px, 280px" width={portrait.width} height={portrait.height} alt="Sunil Paudel, also known as Khosta, video editor" loading="eager" fetchpriority="high" decoding="async"><span class="paper-grain" aria-hidden="true"></span></div>
          <figcaption>SUNIL PAUDEL <span>behind the cut.</span></figcaption>
          <span class="paper-fold paper-fold-top" aria-hidden="true"></span><span class="paper-fold paper-fold-bottom" aria-hidden="true"></span>
        </div>
      </figure>
      <div class="hero-copy">
      <div class="eyebrow"><span class="tiny-line"></span> SUNIL PAUDEL / A.K.A KHOSTA</div>
      <h1 id="hero-title"><span class="sans-lead">Good footage.</span><br><em>Unforgettable stories.</em></h1>
      <p>I turn moments into something you feel.<br>Video editing, with a little more soul.</p>
      <div class="hero-actions"><a class="button primary" href="#work">Explore my work <span>↘</span></a><a class="text-link" href="#contact">Have a story in mind? <span>↗</span></a></div>
      <div class="hero-note"><span class="status-dot"></span> Independent video editor <span class="note-separator">/</span> Made with intention.</div>
      </div>
      </div>
    </section>

    <section class="reel-section wrap" aria-label="Featured reel">
      <button class="reel" id="reel-button" aria-label={hasShowreel ? 'Play Khosta’s showreel' : 'Play sample reel'}>
        <img class="reel-image" src={heroVariants[2].src} srcset={heroSrcset} sizes="(max-width: 700px) calc(100vw - 38px), (max-width: 1280px) calc(100vw - 96px), 1184px" width={reel.width} height={reel.height} decoding="async" alt="Sunlight breaking through clouds over a dramatic mountain landscape" fetchpriority="high">
        <div class="reel-shade"></div><div class="reel-top"><span class="mini-mark brand-logo logo-static" aria-hidden="true"></span><span id="reel-type">A LITTLE TASTE OF THE FEELING</span></div>
        <span class="reel-title">Every frame.<br><em>A feeling.</em></span>
        <span class="play-circle" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 5 11 7-11 7z"/></svg></span>
        <span class="reel-bottom"><span id="reel-label">{hasShowreel ? 'PLAY SHOWREEL' : 'PLAY SAMPLE REEL'} <span>↗</span></span><span id="reel-caption">{hasShowreel ? 'SUNIL PAUDEL / KHOSTA' : 'DEMO FOOTAGE · NOT MY WORK'}</span></span>
      </button>
      <div class="reel-under"><span>THE CUT. THE COLOR. THE FEELING.</span><span>Sound on. World off. <span class="sound-icon">▂▅▃▇▂</span></span></div>
    </section>

    <section class="work-section wrap section" id="work" aria-labelledby="work-title">
      <div class="section-heading"><div><div class="eyebrow">01 / SELECTED WORK</div><h2 id="work-title"><span class="sans-lead">Less noise.</span><br><em>More story.</em></h2></div><p>Long stories. Quick moments.<br>A different canvas. The same care.</p></div>
      <div class="work-toolbar"><div class="filters" role="group" aria-label="Filter videos"><button class="active" data-filter="all" aria-pressed="true">All work <span id="work-count">00</span></button><button data-filter="youtube" aria-pressed="false">YouTube</button><button data-filter="instagram" aria-pressed="false">Instagram</button><button data-filter="tiktok" aria-pressed="false">TikTok</button></div><span class="toolbar-note">A FEW FRAMES OF WHAT’S NEXT ↙</span></div>
      <WorkGallery portfolio={portfolio} images={optimizedImages} />
      <p class="work-footnote" id="work-footnote">The next chapter is on its way. Original work coming soon.</p>
    </section>

    <section class="about-section wrap section" id="about" aria-labelledby="about-title">
      <div class="about-label"><div class="eyebrow">02 / BEHIND THE TIMELINE</div><span class="big-spark brand-logo" aria-hidden="true"></span></div>
      <div class="about-content"><h2 id="about-title">Hi, I’m Sunil.<br>You can call me <em>Khosta.</em></h2><p>For me, editing is about finding the story hidden between the frames. The right pause. A cut that clicks. A moment that makes you feel something.</p><p>I bring that eye to every timeline, from a story told in seconds to one that needs a little more room.</p><div class="disciplines"><span>Video editing</span><span>Color & mood</span><span>Sound & rhythm</span></div><a class="text-link" href="#contact">Let’s make something worth watching <span>↗</span></a></div>
    </section>

    <section class="wishlist-section wrap section" id="wishlist" aria-labelledby="wishlist-title">
      <div class="section-heading"><div><div class="eyebrow">03 / A LITTLE SOMETHING</div><h2 id="wishlist-title">Good stories.<br><em>Kind gestures.</em></h2></div><p>For the kind souls who asked.<br>A small corner for things I’d love.</p></div>
      <div id="gifts"></div>
    </section>

    <section class="contact-section wrap section" id="contact" aria-labelledby="contact-title">
      <div class="eyebrow"><span class="status-dot"></span> 04 / LET’S CREATE SOMETHING</div>
      <h2 id="contact-title">Your story.<br><em>Our next great cut.</em></h2>
      <a class="contact-email" id="email-link" href="mailto:mailkhosta@gmail.com">mailkhosta@gmail.com <span>↗</span></a>
      <div class="contact-details"><a id="phone-link" href="tel:+9779825833442">+977 982 583 3442</a><span class="contact-divider">/</span><button id="copy-email">Copy email <span>⧉</span></button><span id="copy-status" role="status" aria-live="polite"></span></div>
      <SocialLinks links={portfolio.socials || []} />
    </section>
  </main>
  <footer class="footer wrap"><a class="wordmark" href="#"><span class="brand-logo" aria-hidden="true"></span><span>khosta</span></a><span>© <span id="year">2026</span> Sunil Paudel. Every frame, with care.</span><a href="#">Back to top ↑</a></footer>
  <dialog class="video-dialog" id="video-dialog" aria-labelledby="video-title"><div class="dialog-head"><div><span class="eyebrow" id="video-platform"></span><h3 id="video-title"></h3></div><button class="close-dialog" aria-label="Close video">✕</button></div><div id="video-player"></div><div class="dialog-foot"><span id="video-description"></span><a id="original-link" target="_blank" rel="noopener noreferrer">Watch on original platform ↗</a></div></dialog>
</body>
</html>
